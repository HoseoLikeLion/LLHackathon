# ─────────────────────────────────────────────────────────────
# 이 파일은 "어떤 환경변수가 필요한가" 목록이다. 실제 값을 절대 커밋하지 말 것!
# (Spring은 .env를 자동으로 읽지 않는다 — 아래 방법으로 주입)
#
# · 로컬 개발:   기본적으로 이 값들 없이 동작한다 (local 프로필 = H2 + 폴백 루틴)
#                실제 OpenAI/Supabase를 붙여 보려면
#                IntelliJ Run Configuration > Environment variables 에 등록
# · 운영(Render): Render 대시보드 > Environment 에 아래 키들을 등록
# ─────────────────────────────────────────────────────────────

# --- DB: Supabase Postgres ---
# ⚠️ 반드시 "Session pooler" 접속 문자열 사용 (Direct connection은 IPv6 전용이라 Render에서 접속 불가)
#    Supabase 대시보드 > Connect > Session pooler 값 참고
SPRING_DATASOURCE_URL=jdbc:postgresql://<SESSION_POOLER_HOST>:5432/postgres
SPRING_DATASOURCE_USERNAME=postgres.<PROJECT_REF>
SPRING_DATASOURCE_PASSWORD=

# --- OpenAI ---
OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini    # 기본값 gpt-4o-mini, 품질 부족 시 gpt-4o로 승격

# --- Supabase Storage (사진 업로드) ---
SUPABASE_URL=https://<PROJECT_REF>.supabase.co
SUPABASE_SERVICE_KEY=
# SUPABASE_BUCKET=photos      # 기본값 photos — Public 버킷으로 만들 것

# --- 기타 ---
# CORS_ALLOWED_ORIGINS=https://<프론트 배포 도메인>   # 기본값 * — 제출 전 프론트 도메인으로 좁히기
# DEMO_PHOTO_URL=             # 데모 시드 기록의 대표 사진 URL (비우면 사진 없음 처리)
